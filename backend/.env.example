APP_NAME=AXM Residuos API
APP_ENV=development
API_V1_PREFIX=/api/v1
APP_PORT=8000
POSTGRES_DB=axm_residuos
POSTGRES_USER=axm_demo
POSTGRES_PASSWORD=replace-with-a-random-url-safe-value
POSTGRES_HOST=localhost
POSTGRES_CONTAINER_PORT=5432
TIMEZONE=America/Bogota
ALLOWED_ORIGINS=["http://localhost:4200"]
ADMIN_API_KEY=replace-with-a-64-character-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-separate-64-character-random-secret
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_COOKIE_SECURE=false
